{
  "manifest_version": 3,
  "name": "TaskForge Recorder",
  "version": "0.1.0",
  "description": "Chrome extension for recording browser automation workflows for TaskForge.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TaskForge Recorder"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://localhost:3000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ]
}
