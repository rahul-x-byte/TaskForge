# ====================================================
# TASKFORGE BACKEND ENVIRONMENT VARIABLES
# ====================================================

# Port for Fastify Backend Server (Default: 3001)
PORT=3001
HOST=0.0.0.0

# ----------------------------------------------------
# SUPABASE CONFIGURATION (From Supabase Project Settings -> API)
# ----------------------------------------------------
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://<YOUR-PROJECT-REF>.supabase.co

# Supabase Service Role Secret Key (SERVER-ONLY - Never expose to frontend or extension)
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------
# WORKER SECURITY
# ----------------------------------------------------
# Shared secret for Playwright Worker API authentication
WORKER_SECRET=taskforge-worker-secret-key-2026

# Optional: PostgreSQL Database Connection String (Direct Connection)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<YOUR-PROJECT-REF>.supabase.co:5432/postgres
