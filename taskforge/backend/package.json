{
  "name": "@taskforge/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p ../shared/tsconfig.json && tsc && node --input-type=module -e \"import fs from 'fs'; if(!fs.existsSync('dist/templates')) fs.mkdirSync('dist/templates',{recursive:true}); fs.cpSync('src/templates','dist/templates',{recursive:true});\"",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/static": "^6.12.0",
    "@fastify/websocket": "^10.0.1",
    "@taskforge/shared": "file:../shared",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.2",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.14",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.9",
    "fastify": "^4.26.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.1"
  }
}
